# Build-time configuration for the Photos web app (a SvelteKit fork of Immich).
#
# IMPORTANT: unlike the other two apps, these are read by `svelte.config.js`
# through `process.env`, which means they must be in the SHELL environment when
# you run the build. Copying this file to `.env` is not enough — export them, or
# put them on the command line:
#
#   PUBLIC_SELF_HOST=1 PUBLIC_DAEMONCLIENT_WORKER_URL=https://… npm run build
#
# `daemonclient web` does this for you when self-hosting.

# Set to 1 when building for your own deployment.
#
# It fails SAFE rather than open: with it set, a variable you forget resolves to
# an empty string instead of quietly falling back to an operator address. An app
# that cannot find its server is a visible problem; one silently talking to
# someone else's server is not.
PUBLIC_SELF_HOST=1

# Your worker's address — what `daemonclient setup` printed when it finished.
# The service worker rewrites every /api/* call to this host.
PUBLIC_DAEMONCLIENT_WORKER_URL=https://daemonclient-xxxxxx.your-subdomain.workers.dev

# Your Firebase project id. Sign-in is validated against this project.
PUBLIC_DAEMONCLIENT_FIREBASE_PROJECT_ID=your-project

# Cross-subdomain session broker. Managed service only — leave BLANK for a
# self-hosted install, which signs in against its own Firebase directly and has
# no auth-worker to talk to.
PUBLIC_DAEMONCLIENT_AUTH_URL=
