# Build-time configuration for the accounts portal.
#
# Copy to `.env.local` (gitignored) and fill in. Vite inlines these at BUILD
# time, so a change needs a rebuild, not a restart.
#
# `daemonclient web` sets all of this for you when self-hosting — this file is
# for building by hand or running a dev server.

# ── Self-host switch ──────────────────────────────────────────────────────
# Set to 1 when building for your own deployment. It does one important thing:
# it removes the hosted fallbacks below, so a missing or mistyped variable
# fails the build instead of silently signing your users in against the hosted
# service's Firebase project.
VITE_SELF_HOST=1

# ── Your Firebase project ─────────────────────────────────────────────────
# Required when VITE_SELF_HOST=1. From the Firebase console:
# Project settings → General → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project

# Optional — only used by features a self-hosted install does not need.
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Your worker ───────────────────────────────────────────────────────────
# The address `daemonclient setup` printed when it finished.
VITE_API_BASE=https://daemonclient-xxxxxx.your-subdomain.workers.dev

# ── Where you deployed the other two apps ─────────────────────────────────
# Leave blank if you have not deployed one yet — the dashboard then shows that
# card as unavailable rather than linking somewhere wrong.
VITE_PHOTOS_URL=
VITE_DRIVE_URL=

# ── Optional ──────────────────────────────────────────────────────────────
# Where the setup wizard sends people to deploy the HEIC processor.
VITE_PROCESSOR_REPO_URL=
