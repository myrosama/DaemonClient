# Build-time configuration for the Drive app.
#
# Copy to `.env.local` (gitignored). Vite inlines these at BUILD time, so a
# change needs a rebuild.
#
# `daemonclient web` sets these for you when self-hosting.

# Set to 1 when building for your own deployment. Without it the app falls back
# to the hosted service's API, which is correct for our builds and wrong for
# yours.
VITE_SELF_HOST=1

# Your worker's address — what `daemonclient setup` printed when it finished.
VITE_API_BASE=https://daemonclient-xxxxxx.your-subdomain.workers.dev
